# ============================================================
# SOLARMAP-INDIA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================
# Copy this file to .env and adjust variables to match your deployment.
# Never commit the actual .env file or production credentials.

# Model Checkpoint Path (Half U-Net selected best model)
MODEL_PATH=D:/SolarMap-India/outputs/HalfUNet/models/halfunet_best.pth

# Database Configuration (Phase 8: MongoDB & Prediction History)
# Mode 1 (Unconfigured/Offline): MONGODB_URI= (leave empty)
# Mode 2 (Local Native):        MONGODB_URI=mongodb://localhost:27017/solarmap_india
# Mode 3 (Docker Compose):      MONGODB_URI=mongodb://mongodb:27017/solarmap_india
# Mode 4 (MongoDB Atlas):       MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=solarmap_india
MONGODB_COLLECTION=predictions
# Fallback support for DATABASE_NAME is preserved:
# DATABASE_NAME=solarmap_india

# Application Storage Directories (Relative or Absolute paths using forward slashes)
UPLOAD_DIR=backend/uploads
OUTPUT_DIR=backend/generated
FRONTEND_DIST_DIR=frontend/dist

# API & Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*
